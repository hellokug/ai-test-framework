{"id": "required_fields", "desc": "响应体契约：id/object/created/model/choices/usage 六个规范字段存在且类型正确", "messages": [{"role": "user", "content": "hi"}], "expect": {"resp": [{"path": "id", "type": "str", "nonempty": true}, {"path": "object", "type": "str", "nonempty": true}, {"path": "created", "type": "int"}, {"path": "model", "type": "str", "nonempty": true}, {"path": "choices", "type": "list", "nonempty": true}, {"path": "usage", "type": "dict"}]}}
{"id": "usage_arithmetic", "desc": "响应体契约：usage.total_tokens == prompt_tokens + completion_tokens（字段算术自洽，抓统计 bug）", "messages": [{"role": "user", "content": "hi"}], "expect": {"resp": [{"path": "usage.prompt_tokens", "type": "int"}, {"path": "usage.completion_tokens", "type": "int"}]}}
{"id": "assistant_role", "desc": "响应体契约：choices[0].message.role == assistant", "messages": [{"role": "user", "content": "hi"}], "expect": {"resp": {"path": "choices.0.message.role", "eq": "assistant"}, "nonempty": true}}
{"id": "model_echo", "desc": "响应体契约：响应 model 字段与请求 model 一致（服务端回显身份）", "messages": [{"role": "user", "content": "hi"}], "expect": {"resp": {"path": "model", "type": "str", "nonempty": true}, "nonempty": true}}
{"id": "finish_reason_enum", "desc": "响应体契约：finish_reason ∈ 规范枚举（stop/length/tool_calls/content_filter）", "messages": [{"role": "user", "content": "hi"}], "expect": {"finish_reason": "stop"}}
