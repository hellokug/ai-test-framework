{"id": "select_weather", "desc": "工具选择：问天气应选 get_weather 而非 search_web", "messages": [{"role": "user", "content": "What is the weather in Tokyo right now?"}], "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get the current weather for a city", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name"}}, "required": ["city"]}}}, {"type": "function", "function": {"name": "search_web", "description": "Search the web for arbitrary information", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}], "expect": {"tool": "get_weather", "tool_args_contains": "tokyo"}}
{"id": "select_calculator", "desc": "工具选择：算术应选 calculator 并携带完整表达式", "messages": [{"role": "user", "content": "What is 12 times 7? Use the calculator."}], "tools": [{"type": "function", "function": {"name": "calculator", "description": "Evaluate an arithmetic expression", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}}, {"type": "function", "function": {"name": "get_weather", "description": "Get the current weather for a city", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}], "expect": {"tool": "calculator", "tool_args_contains": "12"}}
{"id": "args_extraction_email", "desc": "参数抽取：从自然语言抽收件人与主题传入 send_email", "messages": [{"role": "user", "content": "Please send an email to bob@example.com with the subject 'Quarterly Report' letting him know the report is ready."}], "tools": [{"type": "function", "function": {"name": "send_email", "description": "Send an email to a recipient", "parameters": {"type": "object", "properties": {"to": {"type": "string", "description": "Recipient email address"}, "subject": {"type": "string", "description": "Email subject"}, "body": {"type": "string", "description": "Email body"}}, "required": ["to", "subject", "body"]}}}, {"type": "function", "function": {"name": "get_weather", "description": "Get the current weather", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}], "expect": {"tool": "send_email", "tool_args_contains": "bob@example.com"}}
{"id": "select_reminder_over_distractors", "desc": "语义区分：'提醒我开会'应选 set_reminder 而非日历/邮件/搜索", "messages": [{"role": "user", "content": "明天下午三点提醒我参加项目评审会。"}], "tools": [{"type": "function", "function": {"name": "set_reminder", "description": "在指定时间设置一条提醒", "parameters": {"type": "object", "properties": {"time": {"type": "string", "description": "提醒时间"}, "note": {"type": "string", "description": "提醒内容"}}, "required": ["time", "note"]}}}, {"type": "function", "function": {"name": "create_calendar_event", "description": "创建多人日历事件并发送邀请", "parameters": {"type": "object", "properties": {"title": {"type": "string"}, "start_time": {"type": "string"}}, "required": ["title", "start_time"]}}}, {"type": "function", "function": {"name": "send_email", "description": "发送邮件", "parameters": {"type": "object", "properties": {"to": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"}}, "required": ["to", "subject", "body"]}}}], "expect": {"tool": "set_reminder", "finish_reason": "tool_calls"}}
{"id": "args_chinese_extraction", "desc": "中文参数抽取：'给张三发邮件'应抽出收件人张三", "messages": [{"role": "user", "content": "给张三发一封邮件，主题是'周报已提交'。"}], "tools": [{"type": "function", "function": {"name": "send_email", "description": "给联系人发送邮件", "parameters": {"type": "object", "properties": {"to": {"type": "string", "description": "收件人姓名或邮箱"}, "subject": {"type": "string", "description": "邮件主题"}, "body": {"type": "string", "description": "邮件正文"}}, "required": ["to", "subject"]}}}, {"type": "function", "function": {"name": "calculator", "description": "计算算术表达式", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}}], "expect": {"tool": "send_email", "tool_args_contains": "张三"}}
{"id": "order_status_lookup", "desc": "参数精确抽取：订单号 SO-2024-8891 应完整传入查询工具", "messages": [{"role": "user", "content": "帮我查一下订单 SO-2024-8891 现在的物流状态。"}], "tools": [{"type": "function", "function": {"name": "get_order_status", "description": "按订单号查询订单物流状态", "parameters": {"type": "object", "properties": {"order_id": {"type": "string", "description": "订单编号"}}, "required": ["order_id"]}}}, {"type": "function", "function": {"name": "search_web", "description": "Search the web", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}], "expect": {"tool": "get_order_status", "tool_args_contains": "SO-2024-8891"}}
{"id": "select_data_tool", "desc": "数据分析请求应选择 SQL 执行工具而非通用搜索", "messages": [{"role": "user", "content": "查询上个月销售额最高的前 10 个商品。"}], "tools": [{"type": "function", "function": {"name": "run_sql", "description": "在销售数据仓库上执行只读 SQL 查询", "parameters": {"type": "object", "properties": {"sql": {"type": "string", "description": "SQL 查询语句"}}, "required": ["sql"]}}}, {"type": "function", "function": {"name": "search_web", "description": "Search the web", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}], "expect": {"tool": "run_sql"}}
{"id": "translate_routing", "desc": "翻译请求应路由到 translate 工具并携带目标语言", "messages": [{"role": "user", "content": "Translate '季度营收超预期' into English using the translation tool."}], "tools": [{"type": "function", "function": {"name": "translate", "description": "Translate text to a target language", "parameters": {"type": "object", "properties": {"text": {"type": "string", "description": "Source text"}, "target_language": {"type": "string", "description": "Target language"}}, "required": ["text", "target_language"]}}}, {"type": "function", "function": {"name": "calculator", "description": "Evaluate arithmetic", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}}], "expect": {"tool": "translate", "tool_args_contains": "english"}}
{"id": "no_tool_chitchat", "desc": "闲聊不应触发任何工具调用", "messages": [{"role": "user", "content": "你好呀，今天心情不错，陪我聊聊天。"}], "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get the current weather", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}], "expect": {"no_tool": true, "nonempty": true}}
{"id": "no_tool_out_of_scope", "desc": "能力边界：工具集不支持订机票时应诚实拒答而非硬凑调用", "messages": [{"role": "user", "content": "帮我订一张明天去上海虹桥的机票。"}], "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get the current weather", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}, {"type": "function", "function": {"name": "calculator", "description": "Evaluate arithmetic", "parameters": {"type": "object", "properties": {"expression": {"type": "string"}}, "required": ["expression"]}}}], "expect": {"no_tool": true, "nonempty": true}}
{"id": "multiturn_final_answer", "desc": "多轮续作：工具结果已就位时应给最终回答而非重复调用", "messages": [{"role": "user", "content": "What is the weather in Tokyo?"}, {"role": "assistant", "content": null, "tool_calls": [{"id": "call_1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\": \"Tokyo\"}"}}]}, {"role": "tool", "tool_call_id": "call_1", "content": "{\"temp_c\": 18, \"condition\": \"cloudy\"}"}], "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get the current weather", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}, "required": ["city"]}}}], "expect": {"no_tool": true, "finish_reason": "stop", "nonempty": true}}
{"id": "multiturn_second_step", "desc": "多轮第二步：已知出发地后应调用查询工具补齐目的地信息", "messages": [{"role": "user", "content": "我想查从北京出发的航班。"}, {"role": "assistant", "content": "请问您要查从北京出发到哪个城市的航班？"}, {"role": "user", "content": "目的地是上海。"}], "tools": [{"type": "function", "function": {"name": "search_flights", "description": "按出发/到达城市查询航班", "parameters": {"type": "object", "properties": {"from_city": {"type": "string", "description": "出发城市"}, "to_city": {"type": "string", "description": "到达城市"}}, "required": ["from_city", "to_city"]}}}], "expect": {"tool": "search_flights", "tool_args_contains": "上海"}}
